# Build context: repository root (parent of docker/).
# Requires BuildKit (default): cache mount + layer cache for faster rebuilds.
FROM node:22-slim AS builder

ENV CI=true
ENV NODE_OPTIONS=--max-old-space-size=8192
ENV TZ=Asia/Shanghai
ENV UTOO_REGISTRY=https://mirrors.cloud.tencent.com/npm/

# utoo(Rust/rustls) 依赖系统 CA 证书库验证 HTTPS；node:22-slim 默认不带，缺了会报
# "invalid peer certificate: UnknownIssuer"，所有 HTTPS 下载全部失败。必须先装。
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g utoo@1.1.12 --registry=https://mirrors.cloud.tencent.com/npm/

WORKDIR /app

# 依赖层：仅 package.json / package-lock.json / .utoo.toml 变化时失效
COPY stockManager/front/package.json stockManager/front/package-lock.json stockManager/front/.utoo.toml ./

# 在 cache mount 内安装，utoo 才能对已下载的包做 hardlink，而不是对每个包跨设备复制。
# 镜像源偶发断连时在本层重试；已成功的包留在 /deps/cache，下次只补失败的包。
# 并发从默认 64 降到 8，避免小机器同时打满镜像源后被断开。
RUN --mount=type=cache,id=stockmanager-utoo-deps,target=/deps \
    mkdir -p /deps/cache /deps/app \
    && cp package.json package-lock.json .utoo.toml /deps/app/ \
    && cd /deps/app \
    && ok=0 \
    && for attempt in 1 2 3 4 5; do \
         if ut install --cache-dir /deps/cache --manifests-concurrency-limit 8; then \
           ok=1; \
           break; \
         fi; \
         echo "ut install attempt ${attempt} failed; cached packages are kept"; \
         sleep $((attempt * 5)); \
       done \
    && test "$ok" = 1 \
    && rm -rf /app/node_modules \
    && cp -a /deps/app/node_modules /app/node_modules

# 源码层：业务代码变化时复用上一层的 node_modules，只重跑 build
COPY stockManager/front ./

RUN ut run build

FROM nginx:stable-alpine AS production

RUN rm -rf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
